{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handysam",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "handysam"
    }
  ],
   "vars": {
    "IMAGEKIT_PUBLIC_KEY": "public_Wmy9zTeALzf4ZO8Cw6t5j202WT4=", 
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/rdojme0pvr"
  },
}

 